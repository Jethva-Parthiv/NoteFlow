# NoteFlow Configuration

# Google AI Studio API Key (Gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Groq API Key (Whisper STT: whisper-large-v3-turbo)
GROQ_API_KEY=

# Notion Internal Integration Token (ntn_... or secret_...)
